PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0

MONGODB_URI=
JWT_SECRET=
OTP_PEPPER=
JWT_ISSUER=bup-fst-journal
JWT_AUDIENCE=bup-fst-admin

CLIENT_URLS=http://localhost:3000

ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_SESSION_IDLE_MINUTES=60

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Journal of FST Admin
ADMIN_OTP_EXPIRY_MINUTES=10
ADMIN_OTP_COOLDOWN_SECONDS=60
ADMIN_OTP_MAX_ATTEMPTS=5

# Persistent filesystem used by the Media Library.
# Development: ./storage
# Production example: /home/jfst/apps/jfst-storage
STORAGE_ROOT=./storage

CITATION_SYNC_ENABLED=true
CITATION_SYNC_INTERVAL_HOURS=24
CITATION_SYNC_STARTUP_DELAY_MINUTES=10
CITATION_SYNC_MAILTO=